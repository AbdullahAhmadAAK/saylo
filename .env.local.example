# Supabase — Project Settings → API
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key   # secret! server-only, never expose to the browser

# Resend — https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxx
# Until you verify a domain in Resend, use the shared sender below.
# After verifying saylo's domain, switch to e.g. "Saylo <hello@yourdomain.com>"
WAITLIST_FROM_EMAIL=Saylo <onboarding@resend.dev>
